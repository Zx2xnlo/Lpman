-- Gas stations: found in the map at runtime (pumps closer than 150 studs belong to the same station)
do
    local stations = {}
    local gs = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("GasStation")
    if gs then
        for _, d in ipairs(gs:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Parent and d.Parent:IsA("BasePart") then
                local p = d.Parent.Position
                local placed = false
                for _, st in ipairs(stations) do
                    if (st.sum / st.n - p).Magnitude < 150 then
                        st.sum = st.sum + p
                        st.n = st.n + 1
                        placed = true
                        break
                    end
                end
                if not placed then
                    stations[#stations + 1] = { sum = p, n = 1 }
                end
            end
        end
    end
    for i, st in ipairs(stations) do
