-- a site is free only if the game says it still has loot (not already taken / not regenerating)
function PR.siteFree(st)
    if not st.prompt or not st.prompt.Parent or not st.prompt.Enabled then return false end
    if st.avail and st.avail:IsA("IntValue") and st.avail.Value <= 0 then return false end
    if st.regen and st.regen:IsA("BoolValue") and st.regen.Value then return false end
    return true
end

function PR.pickSite(job, origin)
    local best, bestD
    local now = os.clock()
    for _, st in ipairs(PR.findSites(job)) do
        if PR.siteFree(st) and (PR.siteBusy[st.prompt] or 0) < now then
            local d = (st.pos - origin).Magnitude
            if not bestD or d < bestD then
                best, bestD = st, d
            end
        end
    end
    return best
end

