--==================================================
-- STREAMER MODE (F8)
-- Hides this script's own UI quickly before screen sharing/recording.
-- This does NOT block screenshots or screen recording by external apps.
--==================================================
local StreamerMode = false
local StreamerGuiStates = {}

local function SetStreamerMode(enabled)
    StreamerMode = enabled
    for _, guiName in ipairs({ "LRIS_UI", "LRIS_Floating", "LRIS_Stats" }) do
        local gui = PlayerGui:FindFirstChild(guiName)
        if gui and gui:IsA("ScreenGui") then
            if enabled then
                if StreamerGuiStates[guiName] == nil then
                    StreamerGuiStates[guiName] = gui.Enabled
                end
                gui.Enabled = false
            else
                local previous = StreamerGuiStates[guiName]
                if previous ~= nil then
                    gui.Enabled = previous
                end
            end
        end
    end
    if not enabled then
        table.clear(StreamerGuiStates)
    end
    print("[LRIS SHOP] Streamer Mode: " .. (enabled and "ON" or "OFF"))
end

Track(UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F8 then
        SetStreamerMode(not StreamerMode)
    end
end))

