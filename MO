    })

    Toggle(VehiclePage, {
        key = "CarNoLimit",
        title = "Unlimited Speed (ปลดล็อกความเร็ว)",
        desc = "ไม่จำกัดความเร็วสูงสุดของสคริปต์ รถจะเร่งต่อไปเรื่อยๆ ตราบที่ยังเร่งอยู่ (เสี่ยงรถพลิก ตกแมพ หรือหลุดจากเซิร์ฟเวอร์)",
    })

    Section(VehiclePage, "Live Status (สถานะ)")

    local card = Panel(VehiclePage, UDim2.new(1, 0, 0, 60))
    Tint(card)
    local line = Text(card, "• ไม่ได้นั่งรถ", 12, FNT.B, "Text")
    line.Position = UDim2.fromOffset(16, 10)
    line.Size = UDim2.new(1, -32, 0, 20)
    local line2 = Text(card, "• ", 12, FNT.M, "Sub")
    line2.Position = UDim2.fromOffset(16, 32)
    line2.Size = UDim2.new(1, -32, 0, 20)

    local lastUi = 0
    Track(RunService.Heartbeat:Connect(function(dt)
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local seat = hum and hum.SeatPart
        if not seat then
            if os.clock() - lastUi > 0.3 then
                lastUi = os.clock()
                line.Text = "• ไม่ได้นั่งรถ"
                line2.Text = "• นั่งรถก่อนแล้วเปิดสวิตช์ด้านบน"
            end
            return
        end

        local root = seat.AssemblyRootPart or seat
        local v = root.AssemblyLinearVelocity
        local h = Vector3.new(v.X, 0, v.Z)
        local sp = h.Magnitude

        if os.clock() - lastUi > 0.3 then
            lastUi = os.clock()
            line.Text = string.format("• ความเร็วตอนนี้: %d studs/s", math.floor(sp + 0.5))
            line2.Text = "• ที่นั่ง: " .. seat.ClassName .. " | เร่ง: " .. (Config.CarBoost and "เปิด" or "ปิด")
        end

        if not Config.CarBoost or sp < 5 then return end
        if UIS:GetFocusedTextBox() then return end

        local braking = UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down)
        if braking then return end

        local forward = UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up)
        if not forward and seat:IsA("VehicleSeat") then
            forward = seat.ThrottleFloat > 0 or seat.Throttle > 0
        end
        if not forward then
            local md = hum.MoveDirection
            forward = md.Magnitude > 0.1 and md:Dot(h.Unit) > 0.2
        end
        if not forward then return end

        local maxSp = Config.CarNoLimit and 3000 or (Config.CarMaxSpeed or 150) -- 3000 = safety ceiling so the physics never explodes
        if sp >= maxSp then return end
        local newSp = math.min(sp * (1 + (Config.CarBoostPower or 0.8) * dt), maxSp)
        root.AssemblyLinearVelocity = Vector3.new(h.X / sp * newSp, v.Y, h.Z / sp * newSp)
    end))
end

