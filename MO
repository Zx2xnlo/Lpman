    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not job or not hrp or not hum or hum.Health <= 0 then
        -- dead or respawning: wait and try again
        task.wait(1)
        return 0
    end

    local site = PR.pickSite(job, hrp.Position)
    if not site then
        Toast("⏳ จุดของ " .. job.label .. " ถูกเก็บไปหมดแล้ว รอรีเจนสักครู่", false)
        task.wait(3)
        return 0
    end

    PR.siteBusy[site.prompt] = os.clock() + 20
    local before = getItemCount(job.item)

    tweenTo(CFrame.new(site.pos + Vector3.new(0, 3, 3)))
    if not PR.waitForLand(1.5) then
        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        PR.waitForLand(1)
    end
    task.wait(0.2)
    pcall(function() site.prompt.RequiresLineOfSight = false end)

    -- someone may have taken it while we were travelling: skip it and pick another site next time
    if not PR.siteFree(site) then
        PR.siteBusy[site.prompt] = os.clock() + 8
        return 0
    end

    PR.jobRunning = true
    local mg = LocalPlayer.PlayerGui:FindFirstChild("Minigame")
    local started = false
    for _ = 1, 3 do
        if not Config.KioskFarmEnabled then break end
        firePrompt(site.prompt)
        local t0 = os.clock()
        while os.clock() - t0 < 2.5 do
            if mg and mg.Enabled then started = true break end
            task.wait(0.05)
        end
        if started then break end
    end

    if started then
        -- the auto-player clicks; wait until the minigame closes
        local t0 = os.clock()
        while mg.Enabled and os.clock() - t0 < 30 and Config.KioskFarmEnabled do
            task.wait(0.1)
        end
        -- the server then runs the steal timer: stay still until the item arrives
        local t1 = os.clock()
        while os.clock() - t1 < (job.stealTime + 4) and Config.KioskFarmEnabled do
            if getItemCount(job.item) > before then break end
            task.wait(0.25)
        end
    end
    PR.jobRunning = false

    local gained = math.max(getItemCount(job.item) - before, 0)
    PR.siteBusy[site.prompt] = os.clock() + (gained > 0 and 5 or 10) -- siteFree() also checks the game's own "Available" flag
    task.wait((Config.JobDelay or 0.5) + math.random() * 0.15)
    return gained
end

-- TIMED LOOP EVENTS (Loop Hydrant / Loop Lights / Loop Crystal): 5 collect points each, hold = 0
PR.loops = {
    Hydrant = { label = "🚰 Loop Hydrant", folder = "Fire_Hydrant" },
    Light = { label = "💡 Loop Lights", folder = "Street_Light" },
    Crystal = { label = "💎 Loop Crystal", folder = "CRYSTAL" },
    Halloween = { label = "🎃 Halloween (เคาะประตู)", kind = "door" },
}
PR.loopBusy = {}

-- is another player already at this point/door? (or is the door's knock sound playing right now)
function PR.siteTaken(st)
    if not Config.SkipOccupied then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local c = PR.getChar(plr)
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - st.pos).Magnitude <= 12 then
                return true
            end
        end
    end
    return st.knock ~= nil and st.knock.Playing
end

function PR.loopSites(key)
    local list = {}
    if PR.loops[key].kind == "door" then
        -- Halloween: every HalloweenDoor model has one "Trick or Treat?" prompt
        local h = Workspace:FindFirstChild("Halloween")
        if h then
            for _, m in ipairs(h:GetChildren()) do
                if m.Name == "HalloweenDoor" then
                    local d = m:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if d and d.Parent and d.Parent:IsA("BasePart") then
                        list[#list + 1] = { prompt = d, pos = d.Parent.Position, knock = d.Parent:FindFirstChild("KnockSound") }
                    end
                end
            end
        end
        return list
    end
    local ev = Workspace:FindFirstChild("Event")
    local f = ev and ev:FindFirstChild(PR.loops[key].folder)
    if not f then return list end
    for _, d in ipairs(f:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Parent and d.Parent:IsA("BasePart") then
            list[#list + 1] = { prompt = d, pos = d.Parent.Position }
        end
    end
    return list
end

-- true while at least one collect point is still available (prompt enabled)
function PR.loopFree(key)
    local isDoor = PR.loops[key].kind == "door"
    local now = os.clock()
    for _, st in ipairs(PR.loopSites(key)) do
        if st.prompt.Enabled and (not isDoor or (PR.loopBusy[st.prompt] or 0) < now) and not PR.siteTaken(st) then
            return true
        end
    end
    return false
end

-- first selected loop event that has something to collect (these have priority over the kiosks)
function PR.pendingLoop(list)
    for _, k in ipairs(list) do
        if PR.loops[k] and PR.loopFree(k) then return k end
    end
    return nil
end

-- collect one point; returns true if it was collected
function PR.collectLoopOnce(key)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then
        task.wait(1)
        return false
    end

    local best, bestD
    local now = os.clock()
    for _, st in ipairs(PR.loopSites(key)) do
        if st.prompt.Enabled and (PR.loopBusy[st.prompt] or 0) < now and not PR.siteTaken(st) then
            local d = (st.pos - hrp.Position).Magnitude
            if not bestD or d < bestD then best, bestD = st, d end
        end
    end
    if not best then
        task.wait(2)
        return false
    end

    -- underground: stand just below the point (kept within the prompt's activation range) and stay held there
    local ug = Config.FarmUnderground
    local depth = math.min(Config.UndergroundDepth or 15, 7)
    if ug then
        tweenTo(CFrame.new(best.pos - Vector3.new(0, depth, 0)), false, true)
    else
        tweenTo(CFrame.new(best.pos + Vector3.new(0, 4, 0)))
        PR.waitForLand(1.5)
    end
    task.wait(0.15)

    -- somebody got here first while we were travelling: skip this one
    if PR.siteTaken(best) then
        PR.loopBusy[best.prompt] = os.clock() + 10
        Toast("👥 มีคนอยู่ที่จุดนี้แล้ว ข้ามไปจุดอื่น", false)
        return false
    end

    -- Halloween doors: knock, wait for the game's answer, then leave this door alone for a while
    if PR.loops[key].kind == "door" then
        local knocked = false
        for _ = 1, 3 do
            if not Config.KioskFarmEnabled or not best.prompt.Parent then break end
            PR.halloweenAt = 0
            pcall(function() best.prompt.RequiresLineOfSight = false end)
            firePrompt(best.prompt)
            local t1 = os.clock()
            while os.clock() - t1 < 4 do
                if PR.halloweenAt > 0 or not best.prompt.Enabled then knocked = true break end
                task.wait(0.1)
            end
            if knocked then break end
        end
        if knocked then task.wait(2.5) end -- let the reward / jumpscare finish
        PR.loopBusy[best.prompt] = os.clock() + (Config.DoorCooldown or 30)
        return knocked
    end

    -- press the point, then wait for the game's own progress bar ("LoopCollect") to start and finish
    -- (leaving early cancels the collection), then confirm that the point really got collected
    local collected = false
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    for _ = 1, 3 do
        if not Config.KioskFarmEnabled or not best.prompt.Parent then break end
        pcall(function() best.prompt.RequiresLineOfSight = false end)
        firePrompt(best.prompt)

        -- 1) did the collecting start? (progress bar appears)
        local started = false
        local t0 = os.clock()
        while os.clock() - t0 < 2.5 do
            if pg and pg:FindFirstChild("LoopCollect") then started = true break end
            if not best.prompt.Enabled then collected = true break end
            task.wait(0.05)
        end

        -- 2) wait until the progress bar is gone (= finished); stay on the spot meanwhile
        if started then
            local t1 = os.clock()
            while pg and pg:FindFirstChild("LoopCollect") and os.clock() - t1 < 30 and Config.KioskFarmEnabled do
                task.wait(0.1)
            end
            -- 3) the server hides the point for us once it is credited
            local t2 = os.clock()
            while os.clock() - t2 < 2 do
                if not best.prompt.Enabled then collected = true break end
                task.wait(0.1)
            end
        end
        if collected then break end
    end
    if not collected then
        PR.loopBusy[best.prompt] = os.clock() + 5
    end
    return collected
end

PR.halloweenAt = 0
do
    local ev = ReplicatedStorage:FindFirstChild("HalloweenResult")
    if ev and ev:IsA("RemoteEvent") then
        Track(ev.OnClientEvent:Connect(function()
            PR.halloweenAt = os.clock()
        end))
    end
end

-- MULTI-KIOSK HELPERS
function PR.selected()
    local list = {}
    for _, key in ipairs(PR.order) do
        if Config["Sel_" .. key] and (KIOSKS[key] or PR.jobs[key] or PR.loops[key]) then
            list[#list + 1] = key
        end
    end
    return list
end

function PR.threshold(key)
    local k = KIOSKS[key]
    if not k then return math.huge end
    if key == "Rock" then
        return k.maxCapacity -- Rock is full at 300
    end
    return k.maxCapacity -- full at 100 (Rock: 300)
end

function PR.isFull(key)
    if PR.loops[key] then return not PR.loopFree(key) end -- a loop with nothing left to collect counts as "done"
    local k = KIOSKS[key]
    return k ~= nil and getItemCount(k.item) >= PR.threshold(key)
end

-- next selected kiosk (after `key`, wrapping) that is not full; returns `key` if none
function PR.nextOpen(list, key)
    local at = 1
    for i, k in ipairs(list) do
        if k == key then at = i break end
    end
    for step = 1, #list - 1 do
        local k = list[(at - 1 + step) % #list + 1]
        if not PR.isFull(k) then return k end
    end
    return key
end

-- MAIN KIOSK AUTO FARM LOOP
task.spawn(function()
    while Screen.Parent do
        if Config.KioskFarmEnabled and not isSelling and not PR.processing then
            local list = PR.selected()
            if #list > 0 then
                local inList = false
                for _, k in ipairs(list) do
                    if k == PR.curKey then inList = true break end
                end
                if not inList then PR.curKey = list[1] end

                -- timed loop events have priority: do them as soon as something is available
                local loopKey = PR.pendingLoop(list)
                if loopKey and PR.curKey ~= loopKey then
                    if PR.curKey and not PR.loops[PR.curKey] then PR.resumeKey = PR.curKey end
                    PR.curKey = loopKey
                end

                local targetKey = PR.curKey
                local kData = KIOSKS[targetKey]

                -- Loop events (hydrant / lights / crystal): collect every available point
                if PR.loops[targetKey] then
                    if PR.lastKey ~= targetKey then
                        if PR.lastKey ~= nil or LocalPlayer:GetAttribute("MinionActive") == true then
                            pcall(function()
                                if CancelAutoFarm then CancelAutoFarm:FireServer() end
                            end)
                            PR.waitMinion(false, 1.2)
                        end
                        PR.lastKey = targetKey
                        Toast("🔄 เปลี่ยนไปฟาม " .. PR.loops[targetKey].label, true)
                    end

                    PR.collectLoopOnce(targetKey)

                    if not PR.loopFree(targetKey) then
                        -- everything collected: go back to what we were doing
                        local back = PR.resumeKey
                        PR.resumeKey = nil
                        local backOk = false
                        for _, k in ipairs(list) do
                            if k == back then backOk = true break end
                        end
                        if backOk then
                            PR.curKey = back
                        else
                            PR.curKey = PR.nextOpen(list, targetKey)
                        end
                        PR.surface(nil)
                        Toast("✅ เก็บ " .. PR.loops[targetKey].label .. " ครบแล้ว", true)
                    end
                    task.wait(0.2)
                    continue
                end

                -- Black Jobs (cement / wire) are done by hand, not by the minion
                if PR.jobs[targetKey] then
                    if PR.lastKey ~= targetKey then
                        if PR.lastKey ~= nil or LocalPlayer:GetAttribute("MinionActive") == true then
                            pcall(function()
                                if CancelAutoFarm then CancelAutoFarm:FireServer() end
                            end)
                            PR.waitMinion(false, 1.2)
                        end
                        PR.lastKey = targetKey
                        Toast("🔄 เปลี่ยนไปฟาม " .. PR.jobs[targetKey].label, true)
                    end

                    local gained = PR.stealOnce(targetKey)
                    PR.jobProgress[targetKey] = (PR.jobProgress[targetKey] or 0) + gained
                    if PR.jobProgress[targetKey] >= (Config.JobRoundAmount or 10) then
                        PR.jobProgress[targetKey] = 0
                        if Config.KioskFarmEnabled then
                            PR.curKey = PR.nextOpen(list, targetKey)
                        end
                    end
                    task.wait(0.3)
                    continue
                end

                -- switch to a different kiosk
                if PR.lastKey ~= targetKey then
                    if PR.lastKey ~= nil or LocalPlayer:GetAttribute("MinionActive") == true then
                        pcall(function()
                            if CancelAutoFarm then CancelAutoFarm:FireServer() end
                        end)
                        PR.waitMinion(false, 1.2)
                    end
                    PR.lastKey = targetKey
                    Toast("🔄 เปลี่ยนไปฟาม " .. kData.name, true)
                    tweenTo(kData.standCF)
                    local pressed = pressKiosk(targetKey)
                    if pressed then
                        -- continue as soon as the minion actually starts (retry the press once if it does not)
                        if not PR.waitMinion(true, 1.0) then
                            pressKiosk(targetKey)
                            PR.waitMinion(true, 1.5)
                        end
                    elseif #list > 1 then
                        -- kiosk not found: skip to the next one
                        PR.curKey = PR.nextOpen(list, targetKey)
                    end
                    continue
                end

                local have = getItemCount(kData.item)

                if have >= PR.threshold(targetKey) then
                    -- kiosk is full: optional process/sell, then move on to the next selected kiosk
                    if targetKey == "Rock" and Config.AutoProcessEnabled then
                        Toast("📦 หินเต็ม (" .. have .. "/" .. kData.maxCapacity .. ")! วาปไปแปรรูป...", true)
                        PR.run(false)
                    elseif targetKey ~= "Rock" and Config.AutoSellEnabled then
                        if SellAllItemsNow(false) then
                            Toast("💰 " .. kData.name .. " เต็ม ขายของตอนราคาดีแล้ว", true)
                        end
                    end

                    if Config.KioskFarmEnabled then
                        local nextKey = PR.nextOpen(list, targetKey)
                        if nextKey ~= targetKey then
                            PR.curKey = nextKey
                        elseif PR.isFull(targetKey) then
                            -- nothing else to farm and this one is still full: wait for it to be emptied
                            task.wait(3)
                        end
                    end
                else
                    -- not full: make sure the kiosk (minion) is running
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if LocalPlayer:GetAttribute("MinionActive") ~= true then
                        if hrp then
                            PR.surface(kData)
                            if (hrp.Position - kData.kioskPos).Magnitude > 8 then
                                tweenTo(kData.standCF)
                            end
                            pressKiosk(targetKey)
                            PR.waitMinion(true, 2.0)
                        end
                    elseif hrp then
                        -- minion is running: stay on the ground or go underground
                        local hidden = hrp:GetAttribute("LRIS_Hidden")
                        if Config.FarmUnderground and not hidden then
                            PR.hide(kData)
                        elseif not Config.FarmUnderground and hidden then
                            PR.surface(kData)
                        end
                    end
                end
            end
        elseif not Config.KioskFarmEnabled then
            -- farming stopped: never leave the character frozen underground
            PR.surface(PR.lastKey and KIOSKS[PR.lastKey] or nil)
        end
        task.wait(0.3)
    end
end)

