-- is the shop price of this item "good" right now?
local function isPriceGood(item)
    if not Config.SellOnlyGoodPrice then return true end
    local price = item.price or 0
    if Config.SellNotDropped and item.prev and price < item.prev then
        return false -- price went down compared to the previous round
    end
    local mx = item.max
    if mx and mx > 0 and price < mx * (Config.MinPricePercent or 60) / 100 then
        return false -- too far below the highest price
    end
    return true
end

-- force = true sells everything regardless of the price (manual button)
local function SellAllItemsNow(notify, force)
