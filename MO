    end
    if ActivePopup then
        ActivePopup:Destroy()
        ActivePopup = nil
    end
end

local themePending = false
local function QueueTheme()
    if themePending then
        return
    end
    themePending = true
    task.defer(function()
        themePending = false
        ApplyTheme()
    end)
end

