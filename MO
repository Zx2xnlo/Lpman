-- FREEZE / UNFREEZE (do NOT anchor: an anchored character stops replicating, so other players
-- would still see us on the ground. Instead: hold still with a BodyVelocity + keep collisions off.)
local MOVE = { conn = nil }

function MOVE.unfreeze(hrp)
    if MOVE.conn then
        MOVE.conn:Disconnect()
        MOVE.conn = nil
    end
    if hrp then
        local bv = hrp:FindFirstChild("FarmBV")
        if bv then bv:Destroy() end
        hrp:SetAttribute("LRIS_Hidden", nil)
        local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

function MOVE.freeze(hrp)
    if not hrp then return end
    hrp:SetAttribute("LRIS_Hidden", true)
    local bv = hrp:FindFirstChild("FarmBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FarmBV"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end
    local hum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = true end

    if MOVE.conn then MOVE.conn:Disconnect() end
    MOVE.conn = RunService.Stepped:Connect(function()
        local c = hrp.Parent
        if not c or not hrp:GetAttribute("LRIS_Hidden") then
            MOVE.unfreeze(hrp)
            return
        end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
        end
    end)
end

-- tween the root part to a CFrame at `speed` studs/second
local function tweenPart(hrp, cf, speed)
    if not hrp or not hrp.Parent then return false end
    local dist = (hrp.Position - cf.Position).Magnitude
    local t = math.max(dist / math.max(speed or 200, 10), 0.05)
    local tw = TweenService:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = cf })
    local done = false
    local conn = tw.Completed:Connect(function() done = true end)
    tw:Play()
    local t0 = os.clock()
    while not done and hrp.Parent and os.clock() - t0 < t + 2 do
        task.wait()
    end
    conn:Disconnect()
    pcall(function() tw:Cancel() end)
    return hrp.Parent ~= nil
end

-- instant = true  -> always teleport
-- otherwise: if "Farm Underground" is on, travel as a tween underground (down -> across -> up),
--            if it is off, teleport.
local function tweenTo(targetCF, instant, keepFrozen)
    if not targetCF then return false end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    -- coming up from underground: unfreeze first
    if hrp:GetAttribute("LRIS_Hidden") then
        MOVE.unfreeze(hrp)
    end

    if (hrp.Position - targetCF.Position).Magnitude < 4 then
        if keepFrozen then MOVE.freeze(hrp) end
        return true
    end

    hrp.AssemblyLinearVelocity = Vector3.zero

    if instant or not Config.UseTween then
        if keepFrozen then MOVE.freeze(hrp) end -- keepFrozen = stay held in place at the target (underground)
        hrp.CFrame = targetCF
        return true
    end

    local start = hrp.Position
    local goal = targetCF.Position
    local depth = Config.UndergroundDepth or 15
    local speed = Config.TweenSpeed or 200
    local lowY = math.max(math.min(start.Y, goal.Y) - depth, -300)

    MOVE.freeze(hrp)

    local ok = tweenPart(hrp, CFrame.new(start.X, lowY, start.Z), speed)           -- 1) go down
    ok = ok and tweenPart(hrp, CFrame.new(goal.X, lowY, goal.Z), speed)           -- 2) travel underground
    ok = ok and tweenPart(hrp, targetCF, speed)                                    -- 3) come up at the target

    if hrp.Parent then
        if not keepFrozen then
            MOVE.unfreeze(hrp)
        end
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    return ok
end

