    ----------------------------------------------------------------
    -- Avatar: headless + Korblox right leg (client side, restorable)
    ----------------------------------------------------------------
    local originals = nil
    local appliedChar = nil

    local function restore()
        local o = originals
        originals = nil
        if not o or not o.char or not o.char.Parent then return end
        pcall(function()
            local head = o.char:FindFirstChild("Head")
            if head then
                head.Transparency = o.headTransparency or 0
                if o.face and not head:FindFirstChild("face") then
                    o.face.Parent = head
                end
            end
            local up = o.char:FindFirstChild("RightUpperLeg")
            if up and o.upMesh then
                up.MeshId = o.upMesh
                up.TextureID = o.upTex or ""
            end
            local low = o.char:FindFirstChild("RightLowerLeg")
            if low then low.Transparency = o.lowTransparency or 0 end
            local foot = o.char:FindFirstChild("RightFoot")
            if foot then foot.Transparency = o.footTransparency or 0 end
        end)
    end

