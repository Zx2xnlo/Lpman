    l1.Position = UDim2.fromOffset(16, 12)
    l1.Size = UDim2.new(1, -32, 0, 20)
    local l2 = Text(card, "• มูลค่ากระเป๋า: -", 12, FNT.M, "Sub")
    l2.Position = UDim2.fromOffset(16, 38)
    l2.Size = UDim2.new(1, -32, 0, 20)

    local cache = nil
    local lastFetch = 0
    local rows = {}
    local listPanel

    local function fetch()
        lastFetch = os.clock()
        pcall(function()
            local st = EconomyState and EconomyState:InvokeServer()
            if st and st.items then cache = st end
        end)
    end

    local ICONS = {
        Rock = "🪨", Wood = "🪵", Carrot = "🥕", Apple = "🍎", Chompoo = "🍏",
        Avocado = "🥑", Copper = "🟤", Iron = "⚙️", Gold = "🥇", Ruby = "♦️", Diamond = "💎",
    }

    local function render()
        if not cache then return end

        local items = {}
        for _, it in ipairs(cache.items) do items[#items + 1] = it end
        table.sort(items, function(a, b) return (a.order or 0) < (b.order or 0) end)

        if #rows ~= #items then
            for _, r in ipairs(rows) do r:Destroy() end
            rows = {}
            for i = 1, #items do
                local r = Text(listPanel, "", 12, FNT.M, "Text")
                r.Position = UDim2.fromOffset(16, 10 + (i - 1) * 26)
                r.Size = UDim2.new(1, -32, 0, 22)
                rows[i] = r
            end
            listPanel.Size = UDim2.new(1, 0, 0, 20 + #items * 26)
        end

        local pData = getPlayerData()
        local raw = pData.__raw or pData
        local total = 0

        for i, it in ipairs(items) do
            local price = it.price or 0
            local prev = it.prev or price
            local diff = prev > 0 and ((price - prev) / prev * 100) or 0
            local arrow = diff > 0.5 and "▲" or (diff < -0.5 and "▼" or "▬")
            local tag = ""
            if it.max and price >= it.max then
                tag = "  ⭐ ราคาสูงสุด"
            elseif it.min and price <= it.min then
                tag = "  ⚠️ ราคาต่ำสุด"
            end
            local have = raw[it.name] or 0
            local value = have * price
            total = total + value

            local goodTag = isPriceGood(it) and "  ✅ ราคาดี" or "  ⏳ รอราคาขึ้น"
            tag = tag .. goodTag
            rows[i].Text = string.format(
                "%s %s  $%s  %s %.0f%% (เดิม $%s)  |  ช่วง $%s-$%s  |  มี %s = $%s%s",
                ICONS[it.name] or "📦", it.name, tostring(price), arrow, math.abs(diff), tostring(prev),
                tostring(it.min or price), tostring(it.max or price), tostring(have), tostring(value), tag
            )
            rows[i].TextColor3 = diff > 0.5 and RGB(74, 222, 128) or (diff < -0.5 and RGB(248, 113, 113) or RGB(180, 180, 190))
        end

        local left = math.max(0, math.floor((cache.nextReset or 0) - Workspace:GetServerTimeNow()))
        l1.Text = string.format("• ⏱️ ราคาจะเปลี่ยนใน %02d:%02d นาที (ทุก %d นาที)", math.floor(left / 60), left % 60, math.floor((cache.interval or 1800) / 60))
        l2.Text = string.format("• 💰 มูลค่ากระเป๋าทั้งหมดตามราคาปัจจุบัน: $%s", tostring(total):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
    end

    do
        local row = Panel(PricePage, UDim2.new(1, 0, 0, 44), "TextButton")
        HoverRow(row)
        Register(row, "refresh price รีเฟรชราคา")
        local title = Text(row, "🔄 รีเฟรชราคาทันที", 13, FNT.B, "Accent", Enum.TextXAlignment.Center)
        title.Size = UDim2.fromScale(1, 1)
        row.MouseButton1Click:Connect(function()
            PlayToggleSound(true)
            task.spawn(function()
                fetch()
                render()
                Toast("🔄 อัปเดตราคาแล้ว", true)
            end)
        end)
    end

    Section(PricePage, "Price List (รายการราคาทุกชนิด)")
    listPanel = Panel(PricePage, UDim2.new(1, 0, 0, 40))
    Tint(listPanel)

    task.spawn(function()
        while Screen.Parent do
            local left = cache and ((cache.nextReset or 0) - Workspace:GetServerTimeNow()) or 0
            if not cache or os.clock() - lastFetch > 30 or (left <= 0 and os.clock() - lastFetch > 5) then
                fetch()
            end
            pcall(render)
            task.wait(1)
        end
    end)
end

