                    local low = char:FindFirstChild("RightLowerLeg")
                    local foot = char:FindFirstChild("RightFoot")
                    if not originals or originals.char ~= char then
                        originals = {
                            char = char,
                            headTransparency = head and head.Transparency,
                            face = nil,
                            upMesh = up and up.MeshId,
                            upTex = up and up.TextureID,
                            lowTransparency = low and low.Transparency,
                            footTransparency = foot and foot.Transparency,
                        }
                    end
                    if head then
                        head.Transparency = 1
                        local face = head:FindFirstChild("face")
                        if face then
                            if not originals.face then
                                originals.face = face:Clone()
                            end
                            face:Destroy()
                        end
                    end
                    if up then
                        up.MeshId = "rbxassetid://9598310133"
                        up.TextureID = "rbxassetid://902843398"
                    end
                    if low then low.Transparency = 1 end
                    if foot then foot.Transparency = 1 end
                end)
            elseif originals then
                restore()
            end
            task.wait()
        end
    end)
end

