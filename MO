function PR.getPrompt()
    local station = Workspace:FindFirstChild("ProcessedStation")
    return station and station:FindFirstChildWhichIsA("ProximityPrompt", true)
end

function PR.run(notify, manual)
    if PR.processing or not PR.event then return false end
    PR.processing = true
    PR.cancel = false

    if notify then Toast("⚙️ กำลังวาปไปจุดแปรรูปหิน...", true) end

    local prompt = PR.getPrompt()
    local stationCF = PR.stationCF
    if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
        stationCF = CFrame.new(prompt.Parent.Position + Vector3.new(0, 3, 3))
    end
    tweenTo(stationCF)
    task.wait(0.4)

    local failedStarts = 0
    while not PR.cancel and (manual or Config.KioskFarmEnabled) and failedStarts < 4 do
        local stones = PR.state.stones
        if not PR.state.running then
            stones = getItemCount("Rock")
        end
        if stones and stones < 2 then break end

        if not PR.state.running then
            -- start the same way the game does: press the station prompt
            PR.event:FireServer("GetStone")
            if prompt then firePrompt(prompt) end
            task.wait(1)
            if not PR.state.running then
                PR.event:FireServer("Start")
                task.wait(1)
            end
            if not PR.state.running then
                failedStarts = failedStarts + 1
                if PR.state.stopReason == "Full" then
                    Toast("⚠️ กระเป๋าเต็ม แปรรูปต่อไม่ได้", false)
                    break
                end
            else
                failedStarts = 0
            end
        else
            task.wait(1)
        end
    end

    if PR.state.running then
        PR.event:FireServer("Stop")
        task.wait(0.3)
    end

    if notify then Toast("✅ แปรรูปหินเสร็จแล้ว", true) end
    PR.processing = false
    return true
end

